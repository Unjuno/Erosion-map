{
  "name": "erosion-map",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Deterministic receiver-driven erosion map and static interactive preview",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:site": "npm run build && node scripts/build-site.mjs",
    "dev": "npm run build:site && node scripts/serve.mjs",
    "test": "npm run build:site && node --check site/app.js && node --check site/account.js && node --test tests/*.test.mjs",
    "dev:full": "npm run build:site && node scripts/run-server.mjs",
    "job": "npm run build && node scripts/daily-job.mjs"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@simplewebauthn/server": "14.0.3"
  }
}
